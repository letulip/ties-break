{
  "name": "ties-break",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run context:audit && vue-tsc -b --force && vitest run --project unit --project component && vite build",
    "context:audit": "node scripts/context-audit.mjs --check",
    "icons": "node scripts/gen-icons.mjs",
    "art": "node scripts/optimize-art.mjs",
    "bench:dual": "vite-node tools/dual-universe-bench.ts",
    "bench:econ": "vite-node tools/econ-bench.ts",
    "bench:endings": "vite-node tools/endings-bench.ts",
    "bench:fatigue": "vite-node tools/fatigue-bench.ts",
    "bench:knock": "vite-node tools/knock-rate.ts",
    "bench:load": "vite-node tools/load-bench.ts",
    "bench:money": "vite-node tools/money-decomposition.ts",
    "bench:radar": "vite-node tools/radar-bench.ts",
    "bench:skill": "vite-node tools/skill-ceiling.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:sim": "vitest run --project sim --no-file-parallelism --reporter=dot",
    "test:all": "vitest run --no-file-parallelism --reporter=dot",
    "test:quiet": "vitest run --project unit --reporter=dot",
    "test:sim:quiet": "vitest run --project sim --no-file-parallelism --reporter=dot",
    "test:component": "vitest run --project component",
    "prepare": "git config core.hooksPath .githooks || true",
    "graph": "node scripts/graph.mjs",
    "graph:check": "node scripts/graph.mjs --check"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.11.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
