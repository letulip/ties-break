{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./dev-dist/**)",
      "Read(./coverage/**)",
      "Read(./package-lock.json)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run bench:*)",
      "Bash(npx vue-tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ]
  }
}
