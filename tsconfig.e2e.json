{
  // THE E2E PROJECT. Playwright runs specs through esbuild, which STRIPS types without checking
  // them - so without this file `e2e/*.spec.ts` would be the only TypeScript in the repo that
  // nothing ever type-checks, and a spec that quietly compiles to nonsense is a spec that reports
  // green for the wrong reason. Referenced from tsconfig.json, so `vue-tsc -b --force` covers it.
  //
  // Separate from tsconfig.app.json rather than folded into its `include`: this code runs in Node,
  // against Playwright's API, and it has no business inheriting the app's `vite/client` and
  // `vite-plugin-pwa/client` ambient types.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM is here for one reason and it is a real one: the callback passed to `page.evaluate` is
    // written in this file but RUNS IN THE BROWSER, so `navigator`, `document` and friends have to
    // resolve at compile time even though nothing in this project touches them from Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
